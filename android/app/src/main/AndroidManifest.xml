<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      唯一声明的权限。用途说明（重要，避免误解）：
      游戏本体严格不联网 —— 模拟层与渲染层没有任何 fetch/XHR/WebSocket，
      仓库里有 tools/check.mjs 做静态守卫。
      这里声明 INTERNET 是因为本应用用 WebView 从内部虚拟域名
      https://appassets.androidplatform.net/ 加载打包在 assets 里的本地页面；
      该域名由 App 自己拦截并直接从 APK 返回文件，请求不会离开设备。
      不这样做的替代方案是 file:// 起源，但那种起源下 DOM Storage 不可靠，
      会导致断点续局、图鉴、试炼进度全部无法保存。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 横屏游戏；不做竖屏布局 -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
